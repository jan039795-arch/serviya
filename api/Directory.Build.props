<Project>
  <!-- Configuración común de todos los proyectos de la API (tasks.md T038). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <!-- packages.lock.json por proyecto: CI restaura con locked-mode y detecta cambios de dependencias. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Vulnerabilidades conocidas en paquetes directos y transitivos (como errores, por TreatWarningsAsErrors). -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
</Project>
